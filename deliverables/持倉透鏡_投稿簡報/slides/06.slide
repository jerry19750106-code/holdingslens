        <Box style={{ background: 'rgba(0,153,255,0.16)', borderRadius: 999, paddingTop: 5, paddingBottom: 5, paddingLeft: 13, paddingRight: 13 }}>
          <Text style={{ fontSize: 13, color: '#7FC4FF' }}>危機壓力測試</Text>
        </Box>
        <Box style={{ background: 'rgba(0,153,255,0.16)', borderRadius: 999, paddingTop: 5, paddingBottom: 5, paddingLeft: 13, paddingRight: 13 }}>
