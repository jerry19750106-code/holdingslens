<Slide style={{ width: '1280px', height: '720px', background: '#0A1628', padding: '18px 64px', position: 'relative', display: 'flex', flexDirection: 'column' }}>
  <Box style={{ height: 64, justifyContent: 'center' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E6F0FA' }}>一份引擎，三端可用</Text>
  </Box>
  <Box style={{ flexDirection: 'row', gap: 32, flex: 1, alignItems: 'stretch' }}>
    <Box style={{ flex: 56, background: 'rgba(0,153,255,0.06)', border: '1px solid rgba(0,226,198,0.2)', borderRadius: 16, paddingTop: 14, paddingBottom: 12, paddingLeft: 12, paddingRight: 12, flexDirection: 'column', alignItems: 'center' }}>
      <svg width={532} height={460} viewBox='0 0 620 536'>
        <rect x='235' y='240' width='150' height='90' rx='14' fill='#0099FF' />
        <text x='310' y='278' fill='#0A1628' fontSize='20' fontWeight='bold' textAnchor='middle'>歸因引擎</text>
        <text x='310' y='304' fill='#0A1628' fontSize='14' textAnchor='middle'>UMD · 一份程式碼</text>
        <line x1='245' y1='278' x2='100' y2='90' stroke='#00E2C6' strokeWidth='2' />
        <line x1='310' y1='240' x2='310' y2='88' stroke='#00E2C6' strokeWidth='2' />
        <line x1='375' y1='278' x2='520' y2='90' stroke='#00E2C6' strokeWidth='2' />
        <line x1='310' y1='330' x2='310' y2='426' stroke='#00E2C6' strokeWidth='2' />
        <rect x='30' y='24' width='130' height='60' rx='12' fill='rgba(0,226,198,0.15)' stroke='#00E2C6' />
        <text x='95' y='60' fill='#E6F0FA' fontSize='17' textAnchor='middle'>H5 網頁</text>
        <rect x='245' y='24' width='130' height='60' rx='12' fill='rgba(0,226,198,0.15)' stroke='#00E2C6' />
        <text x='310' y='60' fill='#E6F0FA' fontSize='17' textAnchor='middle'>微信小程序</text>
        <rect x='460' y='24' width='130' height='60' rx='12' fill='rgba(0,226,198,0.15)' stroke='#00E2C6' />
        <text x='525' y='60' fill='#E6F0FA' fontSize='17' textAnchor='middle'>本地腳本</text>
        <rect x='220' y='430' width='180' height='60' rx='12' fill='rgba(0,153,255,0.12)' stroke='#0099FF' />
        <text x='310' y='468' fill='#E6F0FA' fontSize='17' textAnchor='middle'>風險體檢卡</text>
        <text x='310' y='522' fill='#E6F0FA' fontSize='13' opacity='0.55' textAnchor='middle'>同一輸入 → 同一輸出，三端結果一致</text>
      </svg>
      <Text style={{ fontSize: 14, color: '#E6F0FA', opacity: 0.55, marginTop: 8, textAlign: 'center' }}>三端共用同一份 assetlib.js + engine.js，改一處、全端生效</Text>
      <Box style={{ flexDirection: 'row', gap: 10, marginTop: 12, alignSelf: 'stretch' }}>
        <Box style={{ flex: 1, background: 'rgba(0,153,255,0.05)', border: '1px solid rgba(0,153,255,0.2)', borderRadius: 10, paddingTop: 10, paddingBottom: 10, alignItems: 'center' }}>
          <Text style={{ fontSize: 13, color: '#7FC4FF' }}>零 npm 依賴</Text>
        </Box>
        <Box style={{ flex: 1, background: 'rgba(0,153,255,0.05)', border: '1px solid rgba(0,153,255,0.2)', borderRadius: 10, paddingTop: 10, paddingBottom: 10, alignItems: 'center' }}>
          <Text style={{ fontSize: 13, color: '#7FC4FF' }}>17 類資產</Text>
        </Box>
        <Box style={{ flex: 1, background: 'rgba(0,153,255,0.05)', border: '1px solid rgba(0,153,255,0.2)', borderRadius: 10, paddingTop: 10, paddingBottom: 10, alignItems: 'center' }}>
          <Text style={{ fontSize: 13, color: '#7FC4FF' }}>126 項測試</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ flex: 44, flexDirection: 'column', gap: 10 }}>
      <Box style={{ flex: 1, background: 'rgba(0,153,255,0.08)', border: '1px solid rgba(0,153,255,0.28)', borderRadius: 12, paddingTop: 14, paddingBottom: 14, paddingLeft: 18, paddingRight: 18, justifyContent: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#E6F0FA' }}>同一份引擎，不依賴雲端</Text>
        <Text style={{ fontSize: 16, color: '#E6F0FA', opacity: 0.72, marginTop: 5, lineHeight: 1.55 }}>核心計算是 UMD 模組，持倉資料不上傳任何伺服器。</Text>
      </Box>
      <Box style={{ flex: 1, background: 'rgba(0,226,198,0.07)', border: '1px solid rgba(0,226,198,0.26)', borderRadius: 12, paddingTop: 14, paddingBottom: 14, paddingLeft: 18, paddingRight: 18, justifyContent: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#E6F0FA' }}>同一套數學，三端一致</Text>
        <Text style={{ fontSize: 16, color: '#E6F0FA', opacity: 0.72, marginTop: 5, lineHeight: 1.55 }}>網頁、小程序、本地腳本分別跑，結果可交叉驗證。</Text>
      </Box>
      <Box style={{ flex: 1, background: 'rgba(255,214,102,0.07)', border: '1px solid rgba(255,214,102,0.26)', borderRadius: 12, paddingTop: 14, paddingBottom: 14, paddingLeft: 18, paddingRight: 18, justifyContent: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#E6F0FA' }}>按場景選端，不用裝軟體</Text>
        <Text style={{ fontSize: 16, color: '#E6F0FA', opacity: 0.72, marginTop: 5, lineHeight: 1.55 }}>即開即用看 H5，批量回測用腳本，小程序原始碼見 GitHub。</Text>
      </Box>
      <Box style={{ flex: 1, background: 'rgba(0,153,255,0.05)', border: '1px solid rgba(0,153,255,0.2)', borderRadius: 12, paddingTop: 12, paddingBottom: 12, paddingLeft: 18, paddingRight: 18, flexDirection: 'row', flexWrap: 'wrap', gap: 10, alignItems: 'center' }}>
