/* ============================================================
 * 全局样式 · 深色科技风
 * 色板对齐投稿视觉规范：DARK #071322 / ACCENT #0099FF
 * ========================================================== */

page {
  --bg: #071322;
  --surface: #0D1E33;
  --surface-2: #112742;
  --line: rgba(122, 168, 222, 0.15);
  --line-2: rgba(122, 168, 222, 0.28);
  --text: #E7F0FB;
  --dim: #7C93B2;
  --dim-2: #5A6E8A;
  --accent: #0099FF;
  --cyan: #00E2C6;
  --danger: #FF4D6A;
  --warn: #FFA53D;
  --good: #23D18B;

  background: #071322;
  color: #E7F0FB;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 28rpx 220rpx;
  min-height: 100vh;
}

/* ---------- 顶栏 ---------- */
.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
}
.logo {
  display: flex;
  align-items: center;
}
.logo .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #0099FF;
  margin-right: 16rpx;
  box-shadow: 0 0 18rpx rgba(0, 153, 255, 0.9);
}
.logo text {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.lang {
  border: 1rpx solid rgba(122, 168, 222, 0.28);
  border-radius: 100rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #7C93B2;
}
.lang:active {
  color: #E7F0FB;
  border-color: #0099FF;
}

/* ---------- Hero ---------- */
.hero {
  padding: 30rpx 0 36rpx;
}
.kicker {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #00E2C6;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.h1 {
  font-size: 58rpx;
  line-height: 1.28;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -1rpx;
  white-space: pre-line;
  margin-bottom: 20rpx;
}
.sub {
  font-size: 26rpx;
  color: #7C93B2;
  line-height: 1.65;
}

/* ---------- 区块 ---------- */
.block {
  margin-bottom: 44rpx;
}
.block-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #7C93B2;
}
.block-h .em {
  font-size: 21rpx;
  color: #5A6E8A;
  font-weight: 400;
}
.block-h .num {
  font-size: 26rpx;
  color: #E7F0FB;
  font-weight: 600;
}

/* ---------- 预设 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  border: 1rpx solid rgba(122, 168, 222, 0.15);
  background: rgba(17, 39, 66, 0.55);
  border-radius: 18rpx;
  padding: 16rpx 28rpx;
  font-size: 25rpx;
  margin: 0 16rpx 16rpx 0;
  color: #E7F0FB;
}
.chip:active {
  border-color: #0099FF;
  background: rgba(0, 153, 255, 0.12);
}
.chip.hot {
  border-color: rgba(0, 226, 198, 0.45);
  color: #00E2C6;
}

/* ---------- 资产网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.asset {
  width: 50%;
  padding: 0 8rpx 16rpx;
}
.asset .inner {
  border: 1rpx solid rgba(122, 168, 222, 0.15);
  background: rgba(13, 30, 51, 0.66);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  position: relative;
}
.asset.sel .inner {
  border-color: rgba(0, 153, 255, 0.6);
  background: rgba(0, 153, 255, 0.13);
}
.asset.sel .inner::after {
  content: "";
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0099FF;
  box-shadow: 0 0 12rpx #0099FF;
}
.asset .n {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #E7F0FB;
  margin-bottom: 6rpx;
}
.asset .v {
  display: block;
  font-size: 21rpx;
  color: #5A6E8A;
}

/* ---------- 持仓 ---------- */
.hold-list {
  display: flex;
  flex-direction: column;
}
.hold {
  display: flex;
  align-items: center;
  background: rgba(13, 30, 51, 0.7);
  border: 1rpx solid rgba(122, 168, 222, 0.15);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}
.hold .nm {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hold .amt {
  width: 200rpx;
  background: rgba(7, 19, 34, 0.85);
  border: 1rpx solid rgba(122, 168, 222, 0.15);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  text-align: right;
  color: #E7F0FB;
  height: 60rpx;
  min-height: 60rpx;
}
.hold .del {
  width: 56rpx;
  text-align: center;
  font-size: 34rpx;
  color: #5A6E8A;
  line-height: 1;
  padding: 8rpx 0;
}
.hold .del:active {
  color: #FF4D6A;
}
.empty {
  border: 1rpx dashed rgba(122, 168, 222, 0.28);
  border-radius: 18rpx;
  padding: 44rpx 24rpx;
  text-align: center;
  color: #5A6E8A;
  font-size: 25rpx;
}

/* ---------- 底部按钮 ---------- */
.cta-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #071322;
  border-top: 1rpx solid rgba(122, 168, 222, 0.12);
  z-index: 10;
}
.cta {
  width: 100%;
  border: none;
  border-radius: 24rpx;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #04121F;
  background: linear-gradient(96deg, #00D9FF, #0099FF 62%, #0070E0);
  box-shadow: 0 12rpx 40rpx rgba(0, 153, 255, 0.3);
}
.cta::after {
  border: none;
}
.cta[disabled] {
  opacity: 0.4;
  color: #04121F;
  background: linear-gradient(96deg, #00D9FF, #0099FF 62%, #0070E0);
}
.cta.ghost {
  background: transparent;
  border: 1rpx solid rgba(122, 168, 222, 0.28);
  color: #E7F0FB;
  box-shadow: none;
}

/* ---------- 通用文字色 ---------- */
.c-danger { color: #FF4D6A; }
.c-warn { color: #FFA53D; }
.c-good { color: #23D18B; }
.c-cyan { color: #00E2C6; }
